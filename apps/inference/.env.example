# Dashboard storage proxy (compose default: http://nginx:81 on the Docker network).
# DASHBOARD_STORAGE_URL=http://nginx:81

# CORS for inference HTTP (browser hits). Defaults suit local dashboard on :8080.
# CORS_ALLOW_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# SpineNet weights from Hub: HF_REPO_ID (+ HF_TOKEN for private/gated repos).
HF_REPO_ID=your-username/scoliovis-spine-net
# HF_FILENAME=spine_net_weights.pth
# HF_REVISION=main
# HF_TOKEN=hf_xxx
# MODEL_FILENAME=spine_net_weights.pth

# REDIS_URL=redis://redis:6379/0

# STRUCTLOG_JSON=0
# SPINE_NET_CONF_THRESH=0.20
# SPINE_NET_DEVICE=cuda:0
# TORCH_DEVICE=cpu

# R2 keys live in apps/dashboard/.env (PHP owns uploads).

# OLLAMA_LLM_MODEL=medgemma:4b
# OLLAMA_LLM_TIMEOUT=600

# APP_ENV=prod
# APP_DEBUG=0
# APP_SECRET=
