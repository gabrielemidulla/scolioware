{# Minimal app chrome for Twig pilot pages (no legacy sidebar). #}
<!DOCTYPE html>
<html lang="{{ html_lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'account.title'|trans }}{% endblock %} {{ 'common.brand_suffix'|trans }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="assets/app.css">
</head>
<body>
<header class="sw-twig-header border-bottom py-2 px-3 d-flex align-items-center justify-content-between bg-white shadow-sm">
    <strong class="text-primary"><i class="fa-solid fa-user-doctor me-1"></i> {{ 'common.brand'|trans }}</strong>
    <nav class="d-flex align-items-center gap-3 small">
        <a href="{{ path('home') }}" class="text-decoration-none">{{ 'nav.dashboard'|trans }}</a>
        <span class="text-muted">{{ user.username }}</span>
    </nav>
</header>
<main class="p-4" style="background: var(--sw-content-bg); min-height: calc(100vh - 56px);">
    {% block body %}{% endblock %}
</main>
</body>
</html>
