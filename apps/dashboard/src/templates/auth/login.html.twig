<!DOCTYPE html>
<html lang="{{ html_lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'login.page_title'|trans }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="assets/app.css">
</head>
<body class="sw-auth-body">
<main class="sw-auth-shell">
    <div class="sw-auth-inline">
        <div class="sw-auth-visual" aria-hidden="true"></div>
        <div class="sw-auth-card">
        <div class="sw-auth-brand">
            <img class="sw-brand-logo" src="assets/img/brand-scolioware-teal.svg" width="390" height="65" alt="{{ 'common.brand'|trans }}">
        </div>
        <h1 class="visually-hidden">{{ 'login.heading'|trans }}</h1>
        {% if error != '' %}
            <div class="alert alert-danger py-2 mb-3" role="alert">
                <i class="fa-solid fa-triangle-exclamation"></i> {{ error }}
            </div>
        {% endif %}
        <form method="post" autocomplete="off">
            <input type="hidden" name="csrf_token" value="{{ csrf_token|e('html_attr') }}">
            <div class="mb-3">
                <label class="form-label">{{ 'login.label_username'|trans }}</label>
                <input class="form-control" name="username" required maxlength="64"
                       autofocus autocomplete="username"
                       value="{{ username }}">
            </div>
            <div class="mb-3">
                <label class="form-label">{{ 'login.label_password'|trans }}</label>
                <input class="form-control" type="password" name="password" required
                       autocomplete="current-password">
            </div>
            <button type="submit" class="btn btn-primary w-100">
                <i class="fa-solid fa-right-to-bracket fa-fw"></i> {{ 'login.submit'|trans }}
            </button>
        </form>
        <p class="sw-auth-help mt-3 mb-0 text-muted">
            {{ 'login.help_reset'|trans }}
        </p>
        </div>
    </div>
</main>
<div class="sw-auth-locale-dock">
    {{ sw_locale_switcher_html()|raw }}
</div>
</body>
</html>
