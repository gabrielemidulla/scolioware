# Copy to .env (Symfony + php container).

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_generate_with_openssl_rand_hex_32
APP_SHARE_DIR=var/share

# Optional: bin/seed_admin.php (Docker entrypoint: --if-empty). Non-prod default admin / admin12345.
# SW_ADMIN_USER=
# SW_ADMIN_PASSWORD=

# Cloudflare R2 (S3-compatible) — dashboard PHP only (internal R2 proxy route + R2Storage).
# Inference/workers never receive these; they call the dashboard storage proxy
# at http://nginx:81/internal_r2_blob.php (private vhost, Docker network only).
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
