{% if total_pages > 1 %}
    {% set window = 5 %}
    {% set start = max(1, page - (window / 2)|round(0, 'floor')) %}
    {% set end = min(total_pages, start + window - 1) %}
    {% if end - start + 1 < window %}
        {% set start = max(1, end - window + 1) %}
    {% endif %}
    <nav class="sw-pagination-nav mt-2" aria-label="{{ 'pagination.aria'|trans }}">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item{% if page <= 1 %} disabled{% endif %}">
                {% if page <= 1 %}
                    <span class="page-link">&laquo;</span>
                {% else %}
                    <a class="page-link" href="{{ path(route, query|merge({(page_param): page - 1})) }}">&laquo;</a>
                {% endif %}
            </li>
            {% for i in start..end %}
                <li class="page-item{% if i == page %} active{% endif %}">
                    {% if i == page %}
                        <span class="page-link">{{ i }}</span>
                    {% else %}
                        <a class="page-link" href="{{ path(route, query|merge({(page_param): i})) }}">{{ i }}</a>
                    {% endif %}
                </li>
            {% endfor %}
            <li class="page-item{% if page >= total_pages %} disabled{% endif %}">
                {% if page >= total_pages %}
                    <span class="page-link">&raquo;</span>
                {% else %}
                    <a class="page-link" href="{{ path(route, query|merge({(page_param): page + 1})) }}">&raquo;</a>
                {% endif %}
            </li>
        </ul>
    </nav>
{% endif %}
