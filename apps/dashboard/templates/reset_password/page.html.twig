<!DOCTYPE html>
<html lang="{{ html_lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'reset.title'|trans }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="assets/app.css">
</head>
<body class="sw-auth-body">
<main class="sw-auth-shell">
    <div class="sw-auth-card">
        <div class="sw-auth-locale mb-2">
            {{ sw_locale_switcher_html()|raw }}
        </div>
        <div class="sw-auth-brand">
            <i class="fa-solid fa-bone"></i>
            <span>{{ 'common.brand'|trans }}</span>
        </div>
        <h1 class="sw-auth-title">{{ 'reset.h1'|trans }}</h1>

        {% if success %}
            <div class="alert alert-success py-2">
                <i class="fa-solid fa-circle-check"></i>
                {{ 'reset.success_lead'|trans }}
                <a href="{{ path('login') }}">{{ 'reset.sign_in_link'|trans }}</a>.
            </div>
        {% else %}
            {% if row is not null %}
                <p class="text-muted small mb-3">
                    {{ 'reset.for_user'|trans({'%name%': row.username}) }}
                </p>
            {% endif %}
            {% if error != '' %}
                <div class="alert alert-danger py-2"><i class="fa-solid fa-triangle-exclamation"></i> {{ error|e }}</div>
            {% endif %}
            {% if row is not null %}
                <form method="post" action="{{ path('reset_password') }}" autocomplete="off">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token|e('html_attr') }}">
                    <input type="hidden" name="token" value="{{ token|e('html_attr') }}">
                    <div class="mb-3">
                        <label class="form-label">{{ 'reset.label_new'|trans }}</label>
                        <input class="form-control" type="password" name="new_password" required
                               minlength="{{ min_password_len }}" autocomplete="new-password" autofocus>
                        <div class="form-text">{{ 'reset.min_chars'|trans({'%min%': min_password_len}) }}</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">{{ 'reset.label_confirm'|trans }}</label>
                        <input class="form-control" type="password" name="new_password_confirm" required
                               minlength="{{ min_password_len }}" autocomplete="new-password">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-floppy-disk fa-fw"></i> {{ 'reset.btn_set'|trans }}
                    </button>
                </form>
            {% endif %}
        {% endif %}

        <p class="sw-auth-help mt-3 mb-0 text-muted">
            <a href="{{ path('login') }}"><i class="fa-solid fa-arrow-left"></i> {{ 'reset.back_sign_in'|trans }}</a>
        </p>
    </div>
</main>
</body>
</html>
