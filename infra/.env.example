# Copy to infra/.env. Used by docker compose (inference, php) — do not commit the real file.

# Required for PHI: shared secret. PHP (internal/ R2 proxy) and the inference app must use the same value.
# Example: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INFERENCE_INTERNAL_TOKEN=

# CORS (inference) — same-origin is typical when using the dashboard in the browser; defaults are 8080.
# CORS_ALLOW_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Inference: optional Deta drive project key (see deta.space)
DETA_ID=

# Inference: direct download URL for keypointsrcnn_weights.pt (used if file is missing)
# Example (GitHub release asset): https://github.com/Blankeos/scoliosoft-training/releases/download/latest/keypointsrcnn_weights.pt
MODEL_DOWNLOAD_URL=

# Redis URL is set by docker-compose to redis://redis:6379/0; only override here for non-compose runs.
# REDIS_URL=redis://redis:6379/0

# Optional: structlog JSON logs in inference (1 = json lines, unset = human-readable console)
# STRUCTLOG_JSON=0

# Optional: run Keypoint-RCNN on CPU (default) or CUDA
# KPR_CNN_DEVICE=cpu

# Cloudflare R2 (S3-compatible) for report images (inference, boto3)
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Ollama (LLM) — used by the inference container to draft a radiology-style
# preliminary description from the X-ray. Model is pulled once by `ollama-init`
# when you use an in-compose Ollama profile.
#
# Do NOT set COMPOSE_PROFILES or OLLAMA_INTERNAL_URL here for normal use — the
# repo `scripts/{cpu|nvidia|amd|mps}/run.sh` export them (see `scripts/lib/compose-env.sh`).
# You may still set these in `.env` for CI or if you run `docker compose` by hand
# and want fixed defaults; shell exports take precedence for substitution.
#
#   ./scripts/run.sh
#   ./scripts/build.sh
#   (autodetect: macOS→mps, Linux+NVIDIA→nvidia, Linux+AMD/ROCm→amd, else cpu)
#   Override autodetection:  SV_LLM_TARGET=cpu ./scripts/run.sh
#   Or per-platform: ./scripts/{cpu|nvidia|amd|mps}/run.sh
#
# macOS: use `mps/run.sh` and run Ollama natively (`brew install ollama`, then
# `ollama serve`); Docker Desktop cannot pass the Apple GPU into containers.
# Without in-compose Ollama you must pull the model on the host once, or generation
# returns 404: ./scripts/mps/ollama-pull-llm-model.sh

# OLLAMA_LLM_MODEL=medgemma:4b
# Per-call timeout (seconds) for blocking chat requests; must cover slow CPU hosts.
# OLLAMA_LLM_TIMEOUT=600

# First admin: run once (from repo, with `infra/.env` loaded) — see apps/dashboard/src/seed_admin.php
# SV_SEED_ADMIN_USER=admin
# SV_SEED_ADMIN_PASSWORD=...
# SV_SEED_ADMIN_MUST_CHANGE=1
