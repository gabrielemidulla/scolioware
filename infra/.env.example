# Copy to infra/.env and adjust. Used by docker compose (inference service).
#
# Inference: optional Deta drive project key (see deta.space)
DETA_ID=

# Inference: direct download URL for keypointsrcnn_weights.pt (used if file is missing)
# Example release asset:
MODEL_DOWNLOAD_URL=

# Cloudflare R2 (S3-compatible) for report images — used by inference (boto3)
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
